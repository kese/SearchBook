<Window x:Class="SearchBook.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:SearchBook.Controls"
        Title="SearchBook · 도서상태 일괄 조회"
        Width="1280" Height="820" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Icon="Assets/SearchBook.ico" Background="#E8EFF3" AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver" Drop="Window_Drop">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Width" Value="46"/><Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="0"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ControlBackground" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ControlBackground" Property="Background" Value="#345D74"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="ControlBackground" Property="Background" Value="#16364A"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="11,4"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#416174"/><Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#7690A0" BorderThickness="1" Background="#E8EFF3">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="0"/>
                <RowDefinition Height="*"/><RowDefinition Height="25"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#234A63">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Background="Transparent">
                        <Image Source="Assets/SearchBookTray.png" Width="31" Height="31"
                               Stretch="Uniform" SnapsToDevicePixels="False"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="13,0">
                        <TextBlock Text="SearchBook" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                        <Border Width="1" Height="15" Background="#6F91A5" Margin="12,0"/>
                        <TextBlock Text="도서상태 일괄 조회" Foreground="#DDE9EF" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource WindowControlButton}" Content="&#xE921;" ToolTip="최소화" Click="MinimizeWindow_Click"/>
                        <Button x:Name="MaximizeWindowButton" Style="{StaticResource WindowControlButton}" Content="&#xE922;" ToolTip="최대화" Click="MaximizeWindow_Click"/>
                        <Button Style="{StaticResource WindowControlButton}" Content="&#xE8BB;" ToolTip="닫기" Click="CloseWindow_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="#F8FBFC" BorderBrush="#BFCED7" BorderThickness="0,0,0,1">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ToolbarButton}" Click="ChooseFile_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,7,0"/><TextBlock Text="파일 가져오기"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" Click="CreateTemplate_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,7,0"/><TextBlock Text="입력 서식"/></StackPanel>
                        </Button>
                        <Button x:Name="ExportButton" Style="{StaticResource ToolbarButton}" Background="#176B87" BorderBrush="#176B87" Foreground="White" IsEnabled="False" Click="Export_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,7,0"/><TextBlock Text="결과 저장"/></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="14,12,14,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" FocusVisualStyle="{x:Null}">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}" Padding="0">
                            <StackPanel>
                                <Border Background="#EDF4F7" BorderBrush="#C9D6DE" BorderThickness="0,0,0,1" CornerRadius="6,6,0,0" Padding="14,10">
                                    <Grid>
                                        <StackPanel><TextBlock Text="대상 파일" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="등록번호 목록 불러오기" FontSize="10" Foreground="#718592" Margin="0,2,0,0"/></StackPanel>
                                    </Grid>
                                </Border>
                                <StackPanel Margin="14">
                                    <TextBlock Text="지원 형식  XLSX · TXT · CSV · TSV" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                                    <Border x:Name="DropZoneBorder" Height="96" BorderThickness="1" BorderBrush="#98AFBC" Background="#F7FAFB" CornerRadius="4" Cursor="Hand" MouseLeftButtonUp="DropZone_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="18" Background="#DDEDF3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#176B87" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,12,0">
                                                <TextBlock Text="파일 놓기 또는 선택" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="첫 열에서 등록번호를 읽습니다" Foreground="#718592" FontSize="10" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border x:Name="SelectedFilePanel" Background="#E8F3F6" BorderBrush="#9FC2D0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,9,0,0" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="#176B87" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1"><TextBlock x:Name="SelectedFileNameText" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock x:Name="LoadedCountText" Foreground="#5D7381" FontSize="10" Margin="0,2,0,0"/></StackPanel>
                                            <Button Grid.Column="2" Content="변경" Background="Transparent" BorderThickness="0" Foreground="#176B87" Padding="7,4" FontSize="10" Click="ChooseFile_Click"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="0">
                            <StackPanel>
                                <Border Background="#EDF4F7" BorderBrush="#C9D6DE" BorderThickness="0,0,0,1" CornerRadius="6,6,0,0" Padding="14,10">
                                    <Grid>
                                        <StackPanel><TextBlock Text="조회 조건" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="요청 속도와 자동 저장" FontSize="10" Foreground="#718592" Margin="0,2,0,0"/></StackPanel>
                                    </Grid>
                                </Border>
                                <StackPanel Margin="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center"><TextBlock Text="요청 간격" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="0.7초 권장" Foreground="#718592" FontSize="10"/></StackPanel>
                                        <ComboBox x:Name="DelayComboBox" Grid.Column="1" SelectedIndex="2" Padding="7,5" FontSize="11" Background="White" BorderBrush="#AFC0CA">
                                            <ComboBoxItem Tag="300">0.3초</ComboBoxItem><ComboBoxItem Tag="500">0.5초</ComboBoxItem><ComboBoxItem Tag="700">0.7초</ComboBoxItem><ComboBoxItem Tag="1000">1.0초</ComboBoxItem><ComboBoxItem Tag="1500">1.5초</ComboBoxItem>
                                        </ComboBox>
                                    </Grid>
                                    <Border Background="#FFF8E5" BorderBrush="#E4CA79" BorderThickness="1" CornerRadius="4" Padding="9" Margin="0,11,0,0">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="#9C7413"/>
                                            <TextBlock Grid.Column="1" Text="50건마다 자동 저장합니다. 조회 중에도 안전한 Excel 스냅샷을 열 수 있습니다." Foreground="#64531E" FontSize="10" LineHeight="15"/>
                                        </Grid>
                                    </Border>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="62"/></Grid.ColumnDefinitions>
                                        <Button x:Name="StartButton" Height="46" Padding="3" Background="#176B87" BorderBrush="#176B87" Foreground="White" IsEnabled="False" Click="Start_Click">
                                            <Grid Height="32">
                                                <StackPanel x:Name="StartIdleContent" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="조회 시작" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Grid x:Name="StartRunningContent" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <local:LegacyTransferAnimationHost x:Name="LegacyTransferAnimation" Width="190" Height="30" HorizontalAlignment="Center"/>
                                                </Grid>
                                            </Grid>
                                        </Button>
                                        <Button x:Name="CancelButton" Grid.Column="2" Content="중지" Background="#FDF4F4" BorderBrush="#CA8B8B" Foreground="#A12626" IsEnabled="False" Click="Cancel_Click"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="150"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource CardStyle}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Background="#EDF4F7" BorderBrush="#C9D6DE" BorderThickness="0,0,0,1" CornerRadius="6,6,0,0">
                                <Grid Margin="12,0"><TextBlock Text="작업 진행 요약" FontSize="11" FontWeight="SemiBold" Foreground="#36586B" VerticalAlignment="Center"/><TextBlock x:Name="TransferStatusText" Text="조회 대기 중" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#667A89" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></Grid>
                            </Border>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                                <UniformGrid Grid.Column="0" Columns="4" Margin="26,0">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="진행" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="ProgressMetricText" Text="0 / 0" Style="{StaticResource MetricValue}"/></StackPanel>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="성공" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="SuccessMetricText" Text="0" Foreground="#24785D" Style="{StaticResource MetricValue}"/></StackPanel>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="미확인" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="FailureMetricText" Text="0" Foreground="#B44545" Style="{StaticResource MetricValue}"/></StackPanel>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="남은 시간" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="RemainingMetricText" Text="—" Style="{StaticResource MetricValue}"/></StackPanel>
                                </UniformGrid>
                                <Border Grid.Column="1" Background="#D7E1E7"/>
                                <StackPanel Grid.Column="2" Margin="15,10" VerticalAlignment="Center">
                                    <Grid><TextBlock Text="처리 속도" FontSize="10" Foreground="#667A89"/><TextBlock x:Name="SpeedMetricText" Text="— 건/분" HorizontalAlignment="Right" FontSize="10" FontWeight="SemiBold" Foreground="#176B87"/></Grid>
                                    <Canvas Width="210" Height="55" Background="#F4F8FA" Margin="0,7,0,0" ClipToBounds="True">
                                        <Line X1="0" Y1="43" X2="210" Y2="43" Stroke="#CAD8DF"/><Line X1="0" Y1="22" X2="210" Y2="22" Stroke="#E2EAEE" StrokeDashArray="2 3"/>
                                        <Polyline x:Name="SpeedGraphLine" Stroke="#176B87" StrokeThickness="2" StrokeLineJoin="Round"/>
                                    </Canvas>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="3"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Margin="14,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="조회 결과 기록" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="CurrentStatusText" Text="파일을 불러오면 결과 레코드가 표시됩니다." Foreground="#667A89" FontSize="10" Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></StackPanel>
                                <Button x:Name="OpenCurrentResultButton" Grid.Column="1" Height="34" Margin="0,8" VerticalAlignment="Center" Background="White" Foreground="#176B87" BorderBrush="#8FB4C3" Padding="11,5" FontSize="10" IsEnabled="False" ToolTip="작업 중에는 별도의 안전한 Excel 스냅샷을 만듭니다." Click="OpenCurrentResult_Click">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0"/><TextBlock Text="현재 결과 Excel 열기"/></StackPanel>
                                </Button>
                            </Grid>
                            <ProgressBar x:Name="MainProgressBar" Grid.Row="1" Height="3" Minimum="0" Maximum="100" Background="#DCE6EB" Foreground="#2A809D" BorderThickness="0"/>
                            <DataGrid x:Name="ResultsDataGrid" Grid.Row="2" ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeaderWidth="0" Background="White" AlternatingRowBackground="#F5F8FA" HorizontalGridLinesBrush="#D9E3E8" VerticalGridLinesBrush="Transparent" ColumnHeaderHeight="31" RowHeight="31" FontSize="11" EnableRowVirtualization="True" EnableColumnVirtualization="True">
                                <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#DDE8ED"/><Setter Property="Foreground" Value="#344F5F"/><Setter Property="BorderBrush" Value="#BFCED6"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="Padding" Value="9,0"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGrid.ColumnHeaderStyle>
                                <DataGrid.CellStyle><Style TargetType="DataGridCell"><Setter Property="Padding" Value="7,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#D8EBF2"/><Setter Property="Foreground" Value="#233746"/></Trigger></Style.Triggers></Style></DataGrid.CellStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="42"/><DataGridTextColumn Header="등록번호" Binding="{Binding RegistrationNumber}" Width="116"/><DataGridTextColumn Header="조회결과" Binding="{Binding QueryState}" Width="76"/><DataGridTextColumn Header="도서상태" Binding="{Binding BookState}" Width="92"/><DataGridTextColumn Header="소장위치" Binding="{Binding Location}" Width="116"/><DataGridTextColumn Header="청구기호" Binding="{Binding CallNumber}" Width="138"/><DataGridTextColumn Header="서명" Binding="{Binding Title}" Width="245"/><DataGridTextColumn Header="저자" Binding="{Binding Author}" Width="138"/><DataGridTextColumn Header="출판사" Binding="{Binding Publisher}" Width="138"/><DataGridTextColumn Header="출판년" Binding="{Binding PublicationYear}" Width="66"/><DataGridTextColumn Header="ISBN" Binding="{Binding Isbn}" Width="116"/><DataGridTextColumn Header="정보출처" Binding="{Binding DataSource}" Width="170"/><DataGridTextColumn Header="처리메시지" Binding="{Binding Message}" Width="205"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="4" Background="#304E60">
                <Grid Margin="11,0"><TextBlock x:Name="FooterStatusText" Text="준비됨 · 별도 설치 없이 실행" Foreground="#DBE7ED" FontSize="9" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock Text="WIN-X64" Foreground="#A9BDC8" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
            </Border>
        </Grid>
    </Border>
</Window>
