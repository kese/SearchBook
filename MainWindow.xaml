<Window x:Class="SearchBook.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SearchBook · 도서상태 자동 조회" Width="1220" Height="800"
        MinWidth="980" MinHeight="680" WindowStartupLocation="CenterScreen"
        Icon="Assets/SearchBook.ico"
        Background="#F5F7FA" AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver" Drop="Window_Drop">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E6EAF0" BorderThickness="0,0,0,1" Padding="30,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="10" Background="#E9F0FF" Margin="0,0,12,0">
                            <TextBlock Text="⌕" FontSize="27" Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="SearchBook" FontSize="23" FontWeight="Bold"/>
                            <TextBlock Text="한국교통대학교 도서관 등록번호 일괄 조회" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="입력 템플릿" Background="#EEF1F5" Foreground="#394556"
                            Margin="0,0,10,0" Padding="16,9" Click="CreateTemplate_Click"/>
                    <Button x:Name="ExportButton" Content="결과 저장" Background="#E9F0FF" Foreground="{StaticResource PrimaryBrush}"
                            Padding="16,9" IsEnabled="False" Click="Export_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28,24,28,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="1. 등록번호 파일" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text=".xlsx, .txt, .csv 파일을 사용할 수 있습니다." Foreground="{StaticResource MutedBrush}"
                                       FontSize="12" Margin="0,5,0,16"/>
                            <Border x:Name="DropZoneBorder" Height="154" CornerRadius="12" BorderThickness="2"
                                    BorderBrush="#B9C8E8" Background="#F7FAFF" Cursor="Hand"
                                    MouseLeftButtonUp="DropZone_Click">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="42" Height="42" CornerRadius="21" Background="#E4ECFF">
                                        <TextBlock Text="↓" FontSize="24" Foreground="{StaticResource PrimaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                    </Border>
                                    <TextBlock Text="파일을 여기에 끌어 놓으세요" FontWeight="SemiBold" FontSize="13"
                                               HorizontalAlignment="Center" Margin="0,11,0,3"/>
                                    <TextBlock Text="또는 클릭해서 선택" Foreground="{StaticResource PrimaryBrush}" FontSize="12"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="SelectedFilePanel" Background="#F3F5F8" CornerRadius="9" Padding="12"
                                    Margin="0,14,0,0" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="SelectedFileNameText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="LoadedCountText" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="변경" Background="Transparent" Foreground="{StaticResource PrimaryBrush}"
                                            Padding="8,5" Click="ChooseFile_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="2. 조회 설정" FontSize="16" FontWeight="Bold"/>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="116"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="요청 간격" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="서버 보호를 위해 0.7초 권장" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                </StackPanel>
                                <ComboBox x:Name="DelayComboBox" Grid.Column="1" SelectedIndex="2" Padding="9,7" FontSize="13">
                                    <ComboBoxItem Tag="300">0.3초</ComboBoxItem>
                                    <ComboBoxItem Tag="500">0.5초</ComboBoxItem>
                                    <ComboBoxItem Tag="700">0.7초 (권장)</ComboBoxItem>
                                    <ComboBoxItem Tag="1000">1.0초</ComboBoxItem>
                                    <ComboBoxItem Tag="1500">1.5초</ComboBoxItem>
                                </ComboBox>
                            </Grid>
                            <Border Background="#FFF8E8" CornerRadius="8" Padding="11" Margin="0,14,0,0">
                                <TextBlock Text="1만 건은 수 시간이 걸릴 수 있습니다. 50건마다 프로젝트 results 폴더에 중간 결과를 자동 저장합니다."
                                           Foreground="#76571C" FontSize="11" LineHeight="17"/>
                            </Border>
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="StartButton" Content="조회 시작" Background="{StaticResource PrimaryBrush}"
                                        Foreground="White" IsEnabled="False" Click="Start_Click"/>
                                <Button x:Name="CancelButton" Grid.Column="2" Content="중지" Background="#FFE9E9" Foreground="#C33A3A"
                                        Padding="16,11" IsEnabled="False" Click="Cancel_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardStyle}" Padding="20,17">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="진행" Style="{StaticResource MetricLabel}"/>
                            <TextBlock x:Name="ProgressMetricText" Text="0 / 0" Style="{StaticResource MetricValue}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#E6EAF0"/>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="성공" Style="{StaticResource MetricLabel}"/>
                            <TextBlock x:Name="SuccessMetricText" Text="0" Foreground="#17845A" Style="{StaticResource MetricValue}"/>
                        </StackPanel>
                        <Border Grid.Column="3" Background="#E6EAF0"/>
                        <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                            <TextBlock Text="미확인/실패" Style="{StaticResource MetricLabel}"/>
                            <TextBlock x:Name="FailureMetricText" Text="0" Foreground="#C44B4B" Style="{StaticResource MetricValue}"/>
                        </StackPanel>
                        <Border Grid.Column="5" Background="#E6EAF0"/>
                        <StackPanel Grid.Column="6" HorizontalAlignment="Center">
                            <TextBlock Text="남은 시간(예상)" Style="{StaticResource MetricLabel}"/>
                            <TextBlock x:Name="RemainingMetricText" Text="—" Style="{StaticResource MetricValue}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="20,17,20,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="조회 결과" FontSize="16" FontWeight="Bold"/>
                                <TextBlock x:Name="CurrentStatusText" Text="파일을 불러오면 미리보기가 표시됩니다."
                                           Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button x:Name="OpenResultsButton" Grid.Column="1" Content="결과 폴더" Background="#EEF1F5"
                                    Foreground="#394556" Padding="12,7" IsEnabled="False" Click="OpenResults_Click"/>
                        </Grid>
                        <ProgressBar x:Name="MainProgressBar" Grid.Row="1" Height="5" Minimum="0" Maximum="100"
                                     Background="#E9EDF3" Foreground="{StaticResource PrimaryBrush}" BorderThickness="0"/>
                        <DataGrid x:Name="ResultsDataGrid" Grid.Row="2" ItemsSource="{Binding Results}"
                                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" BorderThickness="0" RowHeaderWidth="0"
                                  Background="White" AlternatingRowBackground="#FAFBFD"
                                  HorizontalGridLinesBrush="#EDF0F4" VerticalGridLinesBrush="Transparent"
                                  ColumnHeaderHeight="38" RowHeight="37" FontSize="12"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="48"/>
                                <DataGridTextColumn Header="등록번호" Binding="{Binding RegistrationNumber}" Width="125"/>
                                <DataGridTextColumn Header="조회결과" Binding="{Binding QueryState}" Width="82"/>
                                <DataGridTextColumn Header="도서상태" Binding="{Binding BookState}" Width="105"/>
                                <DataGridTextColumn Header="소장위치" Binding="{Binding Location}" Width="130"/>
                                <DataGridTextColumn Header="청구기호" Binding="{Binding CallNumber}" Width="150"/>
                                <DataGridTextColumn Header="서명" Binding="{Binding Title}" Width="260"/>
                                <DataGridTextColumn Header="저자" Binding="{Binding Author}" Width="150"/>
                                <DataGridTextColumn Header="출판사" Binding="{Binding Publisher}" Width="150"/>
                                <DataGridTextColumn Header="출판년" Binding="{Binding PublicationYear}" Width="75"/>
                                <DataGridTextColumn Header="ISBN" Binding="{Binding Isbn}" Width="125"/>
                                <DataGridTextColumn Header="정보출처" Binding="{Binding DataSource}" Width="190"/>
                                <DataGridTextColumn Header="처리메시지" Binding="{Binding Message}" Width="220"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#EEF1F5" Padding="28,8">
            <TextBlock x:Name="FooterStatusText" Text="준비됨 · 외부 설치 없이 실행" Foreground="#647083" FontSize="11"/>
        </Border>
    </Grid>
</Window>
